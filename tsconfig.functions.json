{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "target": "ES2022",
    "types": ["@cloudflare/workers-types", "vitest/globals"]
  },
  "include": [
    "functions/_middleware.ts",
    "functions/api/_lib/securityHeaders.ts",
    "functions/api/brokers/**/*.ts",
    "functions/api/assistant/**/*.ts",
    "src/lib/brokers/**/*.ts",
    "src/lib/assistant/schemas.ts",
    "src/lib/assistant/types.ts",
    "src/lib/assistant/toolCatalog.ts"
  ],
  "exclude": [
    "src/lib/brokers/client.ts",
    "src/lib/brokers/merge.ts",
    "src/lib/brokers/visibility.ts",
    "src/lib/brokers/*.test.ts"
  ]
}
