# Copy to .dev.vars for `wrangler pages dev` (gitignored — never commit).
# Placeholders only; real values are entered locally or via `wrangler pages secret put`.

# Firebase web API key (server-side copy, used for ID-token verification)
FIREBASE_API_KEY=

# Cross-origin allowlist (same-origin SPA calls need none)
ALLOWED_ORIGINS=

# Comma-separated Firebase uids allowed to open /api/health.
# Empty/unset disables the endpoint entirely — authenticated is not privileged,
# because its payload names which integrations are configured.
HEALTH_OPERATOR_UIDS=

# Market data
UPSTOX_ACCESS_TOKEN=
NEWS_API_KEY=
FINNHUB_API_KEY=

# AI
# AssistZF server-side secrets only. Production uses `wrangler pages secret put
# <NAME>`; never use a VITE_ prefix. Priority: Gemini, OpenAI, then Groq.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Assistant (optional). Leave ASSISTANT_ENABLED unset to keep the assistant on;
# set it to "false" to withdraw the route without a code change. The model
# overrides are optional and server-side only.
# Defaults: gemini-3.5-flash-lite, gpt-4o-mini, llama-3.3-70b-versatile.
# ASSISTANT_ENABLED=true
# ASSISTANT_MODEL_GEMINI=gemini-3.5-flash-lite
# ASSISTANT_MODEL_PRIMARY=gpt-4o-mini
# ASSISTANT_MODEL_FALLBACK=llama-3.3-70b-versatile

# Upstox ops callback (operator secret + OAuth client)
UPSTOX_OPS_KEY=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# INDmoney broker sync (optional; see docs/operations/broker-sync.md)
FIREBASE_PROJECT_ID=
INDSTOCKS_BASE_URL=
INDSTOCKS_API_KEY=
BROKER_TOKEN_KEY=
