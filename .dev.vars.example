# Copy to .dev.vars for `wrangler pages dev` (gitignored — never commit).
# Placeholders only; real values are entered locally or via `wrangler pages secret put`.

# Firebase web API key (server-side copy, used for ID-token verification)
FIREBASE_API_KEY=

# Cross-origin allowlist (same-origin SPA calls need none)
ALLOWED_ORIGINS=

# Comma-separated Firebase uids allowed to open /api/health.
# Empty/unset disables the endpoint entirely — authenticated is not privileged,
# because its payload names which integrations are configured.
HEALTH_OPERATOR_UIDS=

# Market data
UPSTOX_ACCESS_TOKEN=
NEWS_API_KEY=
FINNHUB_API_KEY=

# AI
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Upstox ops callback (operator secret + OAuth client)
UPSTOX_OPS_KEY=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# INDmoney broker sync (optional; see docs/operations/broker-sync.md)
FIREBASE_PROJECT_ID=
INDSTOCKS_BASE_URL=
INDSTOCKS_API_KEY=
BROKER_TOKEN_KEY=
