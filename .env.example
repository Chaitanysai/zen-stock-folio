# ZenFolio environment template — copy to .env.local and fill in.
# Never commit real values.
#
# Architecture:
#   Browser (Vite SPA, hosted on Cloudflare Pages)
#     |- Firebase Auth      -> identity + Firebase ID tokens
#     |- Firestore          -> portfolios/{uid} and users/{uid}
#     '- /api/*             -> Cloudflare Pages Functions (functions/)
#                              verified with those ID tokens
#
# There is no second backend. Firebase Auth and Firestore are the only
# providers; a build with missing values below fails instead of degrading.
#
# VITE_* values are bundled into the browser. Only public, non-secret values
# may use that prefix. Server credentials must NEVER have a VITE_ prefix.

# --- Firebase web app config (browser-public; NOT a secret) ------------------
# Firebase console -> Project settings -> Your apps -> SDK setup and config.
# Access is enforced by Firebase Auth + firestore.rules, not key secrecy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Local API proxy (optional) ---------------------------------------------
# Default: http://localhost:3000. Use http://localhost:8788 for
# `wrangler pages dev` (the Cloudflare Functions runtime).
VITE_API_PROXY_TARGET=

# --- Cloudflare Pages Functions secrets (server-only) -----------------------
# Set with `wrangler pages secret put <NAME>` (or .dev.vars locally).
# FIREBASE_API_KEY is the same public web API key as VITE_FIREBASE_API_KEY;
# the Functions use it for the Identity Toolkit token lookup.
FIREBASE_API_KEY=
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_OPS_KEY=
NEWS_API_KEY=
FINNHUB_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
