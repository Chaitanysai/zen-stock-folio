# ZenFolio environment template — copy to .env.local and fill in.
# Never commit real values.
#
# Architecture:
#   Browser (Vite SPA, hosted on Cloudflare Pages)
#     |- Firebase Auth      -> identity + Firebase ID tokens
#     |- Firestore          -> portfolios/{uid} and users/{uid}
#     '- /api/*             -> Cloudflare Pages Functions (functions/)
#                              verified with those ID tokens
#
# There is no second backend. Firebase Auth and Firestore are the only
# providers; a build with missing values below fails instead of degrading.
#
# VITE_* values are bundled into the browser. Only public, non-secret values
# may use that prefix. Server credentials must NEVER have a VITE_ prefix.

# --- Firebase web app config (browser-public; NOT a secret) ------------------
# Firebase console -> Project settings -> Your apps -> SDK setup and config.
# Access is enforced by Firebase Auth + firestore.rules, not key secrecy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Local API proxy (optional) ---------------------------------------------
# Default: http://localhost:3000. Use http://localhost:8788 for
# `wrangler pages dev` (the Cloudflare Functions runtime).
VITE_API_PROXY_TARGET=

# --- Cloudflare Pages Functions secrets (server-only) -----------------------
# Set with `wrangler pages secret put <NAME>` (or .dev.vars locally).
# FIREBASE_API_KEY is the same public web API key as VITE_FIREBASE_API_KEY;
# the Functions use it for the Identity Toolkit token lookup.
FIREBASE_API_KEY=
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_OPS_KEY=
NEWS_API_KEY=
FINNHUB_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Broker connection framework (server-only) -------------------------------
# Read-only portfolio import from Zerodha Kite Connect and Groww Trading API.
# Full procedure: docs/brokers/setup.md. Leave blank to keep the feature inert.
#
# BROKER_STORE is a KV *binding*, not an environment value. Create the namespace
# and bind it in wrangler.toml / the Pages dashboard:
#   wrangler kv namespace create BROKER_STORE
#
# JSON map of key version -> base64 32-byte AES-GCM key, e.g. {"1":"..."}.
# Generate locally with:
#   node -e "console.log(JSON.stringify({1: require('crypto').randomBytes(32).toString('base64')}))"
# Never commit the real value. Keep every version that still protects a stored
# connection; there is no automatic re-encryption.
BROKER_CREDENTIALS_KEYS=
# Optional: pin new envelopes to a specific version (defaults to the highest).
BROKER_CREDENTIALS_ACTIVE_KEY_VERSION=
# Public HTTPS origin used for provider callbacks, e.g. https://zenfolio-7jd.pages.dev
BROKER_PUBLIC_ORIGIN=
# Optional provider switches: set to "false" to disable. Absent means enabled
# once BROKER_STORE, BROKER_CREDENTIALS_KEYS and BROKER_PUBLIC_ORIGIN are set.
BROKER_ZERODHA_ENABLED=
BROKER_GROWW_ENABLED=
