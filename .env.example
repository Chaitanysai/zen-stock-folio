# Copy to .env.local and fill in. Never commit real values.
#
# VITE_* values are bundled into the browser. Only put public, non-secret
# values there. Keys that grant server access must have NO VITE_ prefix.

# ── Browser-safe (public) ─────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=

# ── Server-only (never expose to the browser) ─────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
FINNHUB_API_KEY=
NEWS_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
